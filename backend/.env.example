# ==============================================================================
# Cloud Workflow Validator - backend environment variables
# The backend reads these from the process environment (export them, or set
# them in the hosting platform). It does not load a .env file by itself.
# Do NOT commit real secrets.
# ==============================================================================

# Allowed CORS origins (comma-separated). Add the deployed frontend's origin.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Largest accepted source in bytes; larger requests get HTTP 413.
# Provisional default until the deployment platform's limits are measured.
MAX_SOURCE_BYTES=524288
