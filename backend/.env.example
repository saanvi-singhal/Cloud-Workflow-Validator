# ==============================================================================
# Cloud Workflow Validator - Backend Environment Configuration Template
# Copy this file to .env before starting the backend service.
# Do NOT commit actual secrets or production keys into version control.
# ==============================================================================

# Runtime environment (development, staging, production)
ENVIRONMENT=development

# Server binding host and port
HOST=0.0.0.0
PORT=8000

# Allowed CORS origins (comma-separated URLs)
# Include local Vite dev server and deployed frontend Vercel URLs
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging verbosity (debug, info, warning, error)
LOG_LEVEL=info
