# ==============================================================================
# Cloud Workflow Validator - Frontend Environment Configuration Template
# Copy this file to .env or .env.local before running the Vite dev server.
# ==============================================================================

# Backend API endpoint URL consumed by React / Vite client
# Local development default: http://localhost:8000
# Production / Vercel preview: Deployed backend URL (e.g., https://<backend-project>.vercel.app)
VITE_API_BASE_URL=http://localhost:8000

# Set to true to use the bundled mock responses instead of calling the backend
# (frontend/src/mocks/, regenerated by frontend/scripts/generate_mocks.py).
VITE_USE_MOCK=false
