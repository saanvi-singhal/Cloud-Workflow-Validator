# ==============================================================================
# Cloud Workflow Validator - Root Environment Template
# Reference file for overall repository configuration.
# Subprojects (backend/ and frontend/) have dedicated .env.example files.
# ==============================================================================

# Backend settings (used in backend/.env)
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=info

# Frontend settings (used in frontend/.env)
VITE_API_BASE_URL=http://localhost:8000
