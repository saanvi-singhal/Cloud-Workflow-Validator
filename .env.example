# ==============================================================================
# Cloud Workflow Validator - environment reference
# backend/.env.example and frontend/.env.example list each side's variables.
# The backend reads the process environment; it does not load .env files.
# ==============================================================================

# Backend
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_SOURCE_BYTES=524288

# Frontend (read by Vite at build time)
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK=false
